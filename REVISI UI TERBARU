function saveRecord(){
  const {v,d}=update(); const kode=(v.f_kode||"").trim();
  if(!kode){ toast("Isi kode subjek dulu (Bagian 1)."); $("#f_kode").focus(); return; }
  const rec={kode,v,d,files:{uf:files.uf,dta:files.dta,bn:files.bn.slice(),wall:files.wall.slice()},example:isExample,savedAt:new Date().toISOString()};
  const i=records.findIndex(r=>r.kode===kode); const isUpdate=i>=0;
  if(isUpdate) records[i]=rec; else records.push(rec);
  renderTable();
  toast(`${kode} ${isUpdate?"diperbarui":"tersimpan"} · ${d.status}${d.status!=="Lengkap"?` (${d.reqDone}/${d.reqTotal} wajib)`:""}`);
}
