  if(!dl) return inViewer? false : browserDownload(name,data);
  try{ await dl.save({filename:name,data}); toast(`${name} siap disimpan`); }
  catch(err){ const c=err&&err.code; toast(c==="declined"?"Penyimpanan dibatalkan":c==="rate_limited"?"Masih ada dialog simpan yang terbuka":"Unduhan tidak tersedia di tampilan ini"); }
  return true;
}
$("#btn-csv").addEventListener("click",async()=>{
  if(!records.length){ toast("Belum ada subjek tersimpan."); return; }
  const csv=toCSV(false);
  if(!(await saveFile(`ecrf_boo_ud_lengkap_${stamp()}.csv`,csv))) openModal("CSV lengkap","Unduhan tidak tersedia di tampilan ini. Salin teks berikut lalu tempel ke Excel atau simpan sebagai .csv.",csv);
});
$("#btn-zip").addEventListener("click",async()=>{
  if(!records.length){ toast("Belum ada subjek tersimpan."); return; }
  if(!dl && inViewer){ openModal("Dataset anonim (CSV)","Paket .zip butuh izin unduhan yang tidak tersedia di tampilan ini. Teks CSV anonim di bawah bisa disalin; berkas unggahan perlu dikumpulkan terpisah.",toCSV(true)); return; }
  try{
    if(!window.JSZip) await loadScript("https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js");
    const z=new JSZip(); z.file("dataset_anonim.csv",toCSV(true)); z.file("kamus_data.csv",dictCSV());
    records.forEach(r=>{ const F=r.files;
      if(F.uf) z.file(exportNameFor(r,"uf",F.uf,0),F.uf); if(F.dta) z.file(exportNameFor(r,"dta",F.dta,0),F.dta);
      F.bn.forEach((f,i)=>z.file(exportNameFor(r,"bn",f,i),f)); F.wall.forEach((f,i)=>z.file(exportNameFor(r,"wall",f,i),f)); });
    const blob=await z.generateAsync({type:"blob"});
    await saveFile(`ecrf_boo_ud_anonim_${stamp()}.zip`,blob);
  }catch(e){ toast("Gagal menyusun paket .zip. Coba lagi."); }
});

/* ---------------- Modal & toast ---------------- */
function openModal(t,p,text){ $("#modal-t").textContent=t; $("#modal-p").textContent=p; $("#modal-ta").value=text.replace(/^﻿/,""); $("#modal").hidden=false; }
$("#modal-close").addEventListener("click",()=>{$("#modal").hidden=true;});
$("#modal-copy").addEventListener("click",()=>{ const ta=$("#modal-ta"); const done=()=>toast("Tersalin"); try{ navigator.clipboard.writeText(ta.value).then(done,()=>{ta.select();toast("Teks terpilih — tekan Ctrl/⌘+C");}); }catch(e){ ta.select(); toast("Teks terpilih — tekan Ctrl/⌘+C"); } });
let tt=null; function toast(m){ const t=$("#toast"); t.textContent=m; t.classList.add("show"); clearTimeout(tt); tt=setTimeout(()=>t.classList.remove("show"),3200); }

/* ---------------- Tab ---------------- */
function showTab(name){
  ["form","map","data"].forEach(n=>{ $("#tab-"+n).hidden=n!==name; $("#tab-btn-"+n).setAttribute("aria-selected",String(n===name)); });
}
["form","map","data"].forEach(n=>$("#tab-btn-"+n).addEventListener("click",()=>showTab(n)));
const h=(location.hash||"").slice(1); if(["map","data"].includes(h)) showTab(h);

/* ---------------- Mulai ---------------- */
buildIPSS(); buildNav(); buildDict(); renderTable();
exampleForm();
})();
</script>

