<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<style>:root{color-scheme:light}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>e-CRF ANN BOO–UD</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: tiga kolom — rel bagian (kiri) | formulir CRF (tengah) | lembar ringkasan bergaris kertas uroflow (kanan) */
:root{
  --bg:#EDF2F3; --surface:#FFFFFF; --surface-2:#F5F8F9; --sunk:#E4ECEE;
  --fg:#11242B; --muted:#56696F; --line:#D3DEE1; --line-strong:#B3C4C9;
  --accent:#0B6878; --accent-ink:#FFFFFF; --accent-soft:#DAEEF1; --accent-fg:#08586A;
  --ok:#1A7549; --ok-soft:#DCF1E5; --warn:#935600; --warn-soft:#FAEBD1; --bad:#AE2A20; --bad-soft:#F8DFDC;
  --grid:rgba(11,104,120,.09);
  --f-display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --f-body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
  --r:10px; --r-sm:6px;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#0B1316; --surface:#121E22; --surface-2:#162529; --sunk:#0E181B;
  --fg:#E1EBED; --muted:#8FA3A9; --line:#24373D; --line-strong:#354B52;
  --accent:#4DB4C5; --accent-ink:#06242A; --accent-soft:#143841; --accent-fg:#83D2DE;
  --ok:#5CC38E; --ok-soft:#13342A; --warn:#E3A64B; --warn-soft:#382B12; --bad:#F07D73; --bad-soft:#3D1D1A;
  --grid:rgba(77,180,197,.08); color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg:#0B1316; --surface:#121E22; --surface-2:#162529; --sunk:#0E181B;
  --fg:#E1EBED; --muted:#8FA3A9; --line:#24373D; --line-strong:#354B52;
  --accent:#4DB4C5; --accent-ink:#06242A; --accent-soft:#143841; --accent-fg:#83D2DE;
  --ok:#5CC38E; --ok-soft:#13342A; --warn:#E3A64B; --warn-soft:#382B12; --bad:#F07D73; --bad-soft:#3D1D1A;
  --grid:rgba(77,180,197,.08); color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none !important}
body{background:var(--bg);color:var(--fg);font-family:var(--f-body);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--f-display);font-weight:700;letter-spacing:-.01em;text-wrap:balance;margin:0}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.num,.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.wrap{max-width:1440px;margin:0 auto;padding-inline:24px}
@media (max-width:600px){.wrap{padding-inline:16px}}

/* ---------- Header ---------- */
.masthead{border-bottom:1px solid var(--line);background:var(--surface)}
.masthead .wrap{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px;padding-block:20px 0}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;margin:0 0 6px}
.masthead h1{font-size:clamp(20px,2.4vw,27px);line-height:1.18;max-width:46ch}
.masthead .meta{display:flex;flex-wrap:wrap;gap:6px;padding-bottom:4px}
.tabs{display:flex;gap:4px;margin-top:16px;overflow-x:auto;scrollbar-width:none;flex-basis:100%}
.tabs::-webkit-scrollbar{display:none}
.tab{appearance:none;border:0;background:none;padding:10px 14px 12px;font-weight:600;color:var(--muted);border-bottom:3px solid transparent;cursor:pointer;white-space:nowrap}
.tab[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}
.tab .count{font-family:var(--f-mono);font-size:12px;background:var(--sunk);border-radius:999px;padding:1px 7px;margin-left:6px;color:var(--muted)}

.chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;border-radius:999px;padding:3px 10px;border:1px solid var(--line);background:var(--surface-2);color:var(--muted);white-space:nowrap}
.chip.ok{background:var(--ok-soft);border-color:transparent;color:var(--ok)}
.chip.warn{background:var(--warn-soft);border-color:transparent;color:var(--warn)}
.chip.bad{background:var(--bad-soft);border-color:transparent;color:var(--bad)}
.chip.acc{background:var(--accent-soft);border-color:transparent;color:var(--accent-fg)}
.chip .dot{width:7px;height:7px;border-radius:50%;background:currentColor}

/* ---------- Workspace ---------- */
.workspace{display:grid;grid-template-columns:200px minmax(0,1fr) 340px;gap:24px;padding-block:24px 64px;align-items:start}
.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px)}
.rail ol{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.rail a{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:8px;padding:8px 10px;border-radius:var(--r-sm);text-decoration:none;color:var(--fg);font-size:14px;font-weight:500}
.rail a:hover{background:var(--surface)}
.rail .no{font-family:var(--f-mono);font-size:12px;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;border:1.5px solid var(--line-strong);color:var(--muted)}
.rail a[data-done="full"] .no{background:var(--ok);border-color:var(--ok);color:var(--surface)}
.rail a[data-done="part"] .no{border-color:var(--accent);color:var(--accent-fg)}
.rail .frac{font-family:var(--f-mono);font-size:11.5px;color:var(--muted)}
.rail-note{font-size:12.5px;color:var(--muted);margin:16px 10px 0;line-height:1.45}

.chipnav{display:none}

.banner{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;background:var(--accent-soft);color:var(--accent-fg);border-radius:var(--r);padding:12px 16px;margin-bottom:16px;font-size:14px}
.banner b{color:var(--fg)}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);margin-bottom:16px;scroll-margin-top:16px}
.card-h{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:start;padding:18px 20px 14px;border-bottom:1px solid var(--line)}
.card-h .no{font-family:var(--f-mono);font-weight:600;font-size:13px;color:var(--accent-fg);background:var(--accent-soft);border-radius:6px;padding:3px 8px;margin-top:2px}
.card-h h2{font-size:19px;line-height:1.25}
.card-h p{margin:3px 0 0;color:var(--muted);font-size:13.5px;max-width:70ch}
.card-b{padding:18px 20px 20px;display:grid;gap:18px}
.subhead{font-size:12px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:600;margin:0 0 -6px}

.fields{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px 16px}
.full{grid-column:1/-1}
.field{display:grid;gap:5px;align-content:start;min-width:0}
.field>label,.field>.lbl{font-size:13px;font-weight:600}
.req{font-style:normal;font-weight:500;font-size:11px;color:var(--accent-fg);margin-left:4px;letter-spacing:.02em}
.opt{font-style:normal;font-weight:400;font-size:11px;color:var(--muted);margin-left:4px}
input[type=text],input[type=date],input[type=tel],select,textarea{width:100%;min-width:0;background:var(--surface-2);border:1px solid var(--line-strong);border-radius:var(--r-sm);padding:9px 11px;line-height:1.3}
textarea{resize:vertical;min-height:62px}
input:focus,select:focus,textarea:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 3px var(--accent-soft)}
input.bad{border-color:var(--bad)}
.hint{font-size:12px;color:var(--muted);margin:0}
.hint.bad{color:var(--bad)}
.hint.warn{color:var(--warn)}
.unit-in{display:flex;align-items:stretch}
.unit-in input{border-top-right-radius:0;border-bottom-right-radius:0;font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.unit-in .u{display:flex;align-items:center;padding:0 10px;border:1px solid var(--line-strong);border-left:0;border-radius:0 var(--r-sm) var(--r-sm) 0;background:var(--sunk);font-family:var(--f-mono);font-size:12.5px;color:var(--muted);white-space:nowrap}
.readout{display:flex;align-items:center;min-height:39px;padding:0 11px;border-radius:var(--r-sm);background:var(--sunk);font-family:var(--f-mono);font-variant-numeric:tabular-nums;font-weight:500}

/* segmented radios */
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg label{position:relative;display:inline-flex}
.seg input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
.seg span{display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border:1px solid var(--line-strong);border-radius:999px;background:var(--surface);font-size:14px;font-weight:500;cursor:pointer;user-select:none}
.seg span small{font-family:var(--f-mono);font-size:11px;color:var(--muted)}
.seg input:checked+span{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.seg input:checked+span small{color:inherit;opacity:.8}
.seg input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}

.checks{display:grid;gap:8px}
.check{display:grid;grid-template-columns:20px 1fr;gap:10px;align-items:start;font-size:14px;cursor:pointer}
.check input{width:18px;height:18px;margin:2px 0 0;accent-color:var(--accent)}
.check.auto{cursor:default}
.check .tick{width:18px;height:18px;margin-top:2px;border-radius:4px;display:grid;place-items:center;font-size:12px;font-weight:700;border:1.5px solid var(--line-strong);color:var(--muted)}
.check .tick.ok{background:var(--ok);border-color:var(--ok);color:var(--surface)}
.check .tick.bad{background:var(--bad);border-color:var(--bad);color:var(--surface)}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
.panel{border:1px solid var(--line);border-radius:var(--r-sm);padding:14px;background:var(--surface-2);display:grid;gap:10px;align-content:start;min-width:0}
.panel h3{font-family:var(--f-body);font-size:13px;font-weight:600}

/* IPSS */
.ipss-strip{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;padding:10px 14px;border-radius:var(--r-sm);background:var(--surface-2);border:1px solid var(--line);font-size:13.5px}
.ipss-strip b{font-family:var(--f-mono);font-size:15px}
.ipss-list{display:grid;gap:0;border:1px solid var(--line);border-radius:var(--r-sm);overflow:hidden}
.q{border:0;margin:0;padding:14px;border-top:1px solid var(--line);min-width:0}
.q:first-child{border-top:0}
.q.unanswered{background:transparent}
.q legend{float:left;width:100%;padding:0;margin-bottom:10px;display:grid;grid-template-columns:28px 1fr;gap:4px 10px}
.q legend+*{clear:both}
.q .qn{font-family:var(--f-mono);font-weight:600;color:var(--muted);font-size:14px;padding-top:1px}
.q .qt{font-weight:500}
.q .tags{grid-column:2;display:flex;gap:6px;flex-wrap:wrap}
.tag{font-size:11px;font-weight:600;letter-spacing:.03em;border-radius:4px;padding:1px 6px}
.tag.s{background:var(--warn-soft);color:var(--warn)}
.tag.v{background:var(--accent-soft);color:var(--accent-fg)}
.tag.qol{background:var(--sunk);color:var(--muted)}
.scale{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;margin-left:38px}
.scale.s7{grid-template-columns:repeat(7,minmax(0,1fr))}
.scale label{position:relative;display:flex}
.scale input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
.scale .opt-box{flex:1;display:grid;gap:2px;align-content:start;justify-items:center;text-align:center;padding:8px 4px 9px;border:1px solid var(--line-strong);border-radius:var(--r-sm);background:var(--surface);cursor:pointer;user-select:none;min-width:0}
.scale .opt-box b{font-family:var(--f-mono);font-size:17px;line-height:1.1}
.scale .opt-box small{font-size:11px;line-height:1.25;color:var(--muted)}
.scale input:checked+.opt-box{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.scale input:checked+.opt-box small{color:inherit;opacity:.85}
.scale input:focus-visible+.opt-box{outline:2px solid var(--accent);outline-offset:2px}

/* uploads */
.drop{border:1.5px dashed var(--line-strong);border-radius:var(--r);padding:18px;display:grid;gap:8px;justify-items:center;text-align:center;background:var(--surface-2);cursor:pointer;transition:border-color .15s,background .15s;position:relative}
.drop:hover,.drop.over{border-color:var(--accent);background:var(--accent-soft)}
.drop input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.drop .ico{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line);color:var(--accent-fg)}
.drop strong{font-size:14px}
.drop .hint{max-width:46ch}
.drop.compact{padding:12px;grid-template-columns:auto 1fr;justify-items:start;text-align:left;align-items:center}
.drop.compact .ico{width:34px;height:34px}
.filecard{display:grid;grid-template-columns:120px minmax(0,1fr);gap:14px;align-items:start;border:1px solid var(--line);border-radius:var(--r);padding:12px;background:var(--surface-2)}
.filecard .thumb{width:120px;aspect-ratio:3/4;max-width:100%;border-radius:6px;background:var(--sunk);border:1px solid var(--line);overflow:hidden;display:grid;place-items:center;color:var(--muted);font-family:var(--f-mono);font-size:12px}
.filecard .thumb img,.filecard .thumb canvas{width:100%;height:100%;object-fit:contain;background:#fff}
.filecard .fname{font-weight:600;word-break:break-all}
.filecard .fmeta{font-size:12.5px;color:var(--muted);font-family:var(--f-mono)}
.filecard .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px}
.gallery figure{margin:0;position:relative;aspect-ratio:1;border-radius:6px;overflow:hidden;border:1px solid var(--line);background:var(--sunk)}
.gallery img{width:100%;height:100%;object-fit:cover}
.gallery button{position:absolute;top:4px;right:4px;width:24px;height:24px;border-radius:50%;border:0;background:rgba(0,0,0,.6);color:#fff;cursor:pointer;font-size:14px;line-height:1}
.gallery figcaption{position:absolute;left:0;bottom:0;right:0;font-family:var(--f-mono);font-size:10px;padding:2px 5px;background:rgba(0,0,0,.55);color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.btn{appearance:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:var(--r-sm);padding:9px 15px;font-weight:600;font-size:14px;cursor:pointer;border:1px solid var(--line-strong);background:var(--surface);color:var(--fg);text-decoration:none;white-space:nowrap}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.primary:hover{filter:brightness(1.07)}
.btn.ghost{background:transparent}
.btn.sm{padding:5px 10px;font-size:13px}
.btn.danger{color:var(--bad)}
.btn[disabled]{opacity:.5;cursor:not-allowed}

.result-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.result{border:1px solid var(--line);border-radius:var(--r-sm);padding:10px 12px;background:var(--surface-2);display:grid;gap:4px;min-width:0}
.result .k{font-size:12px;color:var(--muted);font-weight:500}
.result .v{font-family:var(--f-mono);font-size:20px;font-weight:600;font-variant-numeric:tabular-nums}
.result .chip{white-space:normal}
.result .f{font-size:11.5px;color:var(--muted);font-family:var(--f-mono)}

.form-foot{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;padding:16px 20px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
.form-foot .grp{display:flex;gap:10px;flex-wrap:wrap}

/* ---------- Summary sheet ---------- */
.sheet{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);background:var(--surface);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.sheet-h{padding:14px 16px 12px;background-color:var(--surface-2);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:12px 12px;border-bottom:1px solid var(--line)}
.sheet-h .lbl{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.sheet-h .code{font-family:var(--f-mono);font-size:20px;font-weight:600;margin-top:2px;word-break:break-all}
.sheet-h .sub{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.sheet-b{padding:4px 16px 16px}
.srow{display:grid;grid-template-columns:1fr auto;gap:4px 10px;align-items:baseline;padding:10px 0;border-bottom:1px solid var(--line)}
.srow:last-child{border-bottom:0}
.srow .k{font-size:13px;color:var(--muted)}
.srow .v{font-family:var(--f-mono);font-weight:600;font-variant-numeric:tabular-nums;text-align:right}
.srow .v small{font-weight:400;color:var(--muted);font-size:11.5px}
.srow .wide{grid-column:1/-1}
.ipss-big{display:flex;align-items:baseline;gap:6px}
.ipss-big b{font-family:var(--f-mono);font-size:34px;line-height:1;font-weight:600}
.ipss-big span{font-family:var(--f-mono);color:var(--muted)}
.bar{display:flex;height:8px;border-radius:999px;overflow:hidden;background:var(--sunk);margin-top:8px}
.bar i{display:block;height:100%}
.bar .s{background:var(--warn)}
.bar .v{background:var(--accent)}
.legend{display:flex;gap:12px;font-size:12px;color:var(--muted);margin-top:6px;font-family:var(--f-mono)}
.legend i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:5px;vertical-align:0}
.progress{height:6px;border-radius:999px;background:var(--sunk);overflow:hidden;margin-top:6px}
.progress i{display:block;height:100%;background:var(--accent);width:0;transition:width .25s}
.sheet-f{padding:12px 16px 16px;display:grid;gap:8px;border-top:1px solid var(--line)}

/* ---------- Mobile bar ---------- */
.mbar{display:none}

/* ---------- Map tab ---------- */
.map{display:grid;grid-template-columns:minmax(0,1.35fr) 28px minmax(0,.8fr) 28px minmax(0,1fr);grid-template-rows:repeat(5,auto);gap:10px 0;align-items:stretch}
.mod{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;min-width:0}
.mod h3{font-size:15px;display:flex;justify-content:space-between;gap:8px;align-items:baseline}
.mod h3 small{font-family:var(--f-mono);font-weight:500;font-size:11px;color:var(--muted)}
.mod ul{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:5px}
.mod li{font-size:12px;background:var(--surface-2);border:1px solid var(--line);border-radius:4px;padding:2px 7px}
.mod li em{font-style:normal;font-family:var(--f-mono);color:var(--muted);font-size:11px;margin-left:4px}
.arrow{display:grid;place-items:center;color:var(--line-strong);font-size:18px}
.branch{border-radius:var(--r);padding:12px 14px;display:grid;align-content:center;gap:4px;background:var(--accent-soft);color:var(--accent-fg);min-width:0}
.branch b{font-family:var(--f-display);font-size:15px;color:var(--fg)}
.branch span{font-size:12.5px}
.fusion{grid-column:5;grid-row:1/6;display:grid;gap:10px;align-content:center}
.fusion .core{border:2px solid var(--accent);border-radius:var(--r);padding:14px;background:var(--surface);text-align:center}
.fusion .core b{font-family:var(--f-display);font-size:17px;display:block}
.fusion .core span{font-size:12.5px;color:var(--muted)}
.outs{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.out{border-radius:var(--r);padding:12px;background:var(--fg);color:var(--bg);text-align:center}
.out b{font-family:var(--f-display);font-size:16px;display:block}
.out span{font-size:11.5px;opacity:.8;font-family:var(--f-mono)}
.gt{border:1px dashed var(--line-strong);border-radius:var(--r);padding:12px;font-size:12.5px;display:grid;gap:4px;background:var(--surface)}
.gt code{font-family:var(--f-mono);font-size:12px;color:var(--fg)}
.section-title{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin:28px 0 12px}
.section-title h2{font-size:20px}
.section-title p{margin:0;color:var(--muted);font-size:13.5px}
.tablebox{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);font-weight:600;background:var(--surface-2);white-space:nowrap;position:sticky;top:0}
tbody tr:last-child td{border-bottom:0}
td.mono,td .mono{font-family:var(--f-mono);font-size:12.5px;font-variant-numeric:tabular-nums}
td.n{text-align:right;font-family:var(--f-mono);font-variant-numeric:tabular-nums;white-space:nowrap}
.grp-row td{background:var(--sunk);font-weight:600;font-size:12.5px;color:var(--muted)}
.empty{padding:40px 20px;text-align:center;display:grid;gap:8px;justify-items:center;color:var(--muted)}
.empty strong{color:var(--fg);font-size:16px}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin:24px 0 12px}
.toolbar .grp{display:flex;flex-wrap:wrap;gap:8px}
.note{font-size:13px;color:var(--muted);max-width:80ch}
.note.warn{color:var(--warn)}

.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);background:var(--fg);color:var(--bg);padding:10px 16px;border-radius:8px;font-size:14px;font-weight:500;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:40;max-width:calc(100vw - 32px)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.modal{position:fixed;inset:0;background:rgba(5,15,18,.55);display:grid;place-items:center;padding:16px;z-index:50}
.modal .box{background:var(--surface);border-radius:var(--r);padding:18px;width:min(720px,100%);display:grid;gap:12px;max-height:90vh;overflow:auto}
.modal textarea{font-family:var(--f-mono);font-size:12px;min-height:240px}

/* ---------- Responsive ---------- */
@media (max-width:1180px){
  .workspace{grid-template-columns:minmax(0,1fr) 310px}
  .rail{display:none}
  .chipnav{display:flex;gap:6px;overflow-x:auto;padding:2px 0 12px;scrollbar-width:none;margin-bottom:4px}
  .chipnav::-webkit-scrollbar{display:none}
  .chipnav a{text-decoration:none}
}
@media (max-width:880px){
  .workspace{grid-template-columns:minmax(0,1fr);padding-bottom:110px}
  .sheet{position:static}
  .mbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--surface);border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));gap:12px;align-items:center;justify-content:space-between}
  .mbar .stats{display:flex;gap:12px;font-family:var(--f-mono);font-size:12.5px;flex-wrap:wrap;min-width:0}
  .mbar .stats b{font-weight:600}
  .toast{bottom:calc(84px + env(safe-area-inset-bottom,0px))}
  .map{grid-template-columns:minmax(0,1fr);grid-template-rows:none}
  .map .arrow{display:none}
  .map>*{grid-column:1 !important;grid-row:auto !important}
  .fusion{margin-top:8px}
}
@media (max-width:600px){
  .scale{grid-template-columns:repeat(3,minmax(0,1fr));margin-left:0}
  .scale.s7{grid-template-columns:repeat(4,minmax(0,1fr))}
  .card-h{padding:16px 16px 12px;grid-template-columns:auto minmax(0,1fr)}
  .card-h>.chip{grid-column:2;justify-self:start}
  .card-b{padding:16px}
  .filecard{grid-template-columns:84px minmax(0,1fr)}
  .filecard .thumb{width:84px}
  .masthead .meta{display:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none !important;scroll-behavior:auto !important}}
</style>
</head>
<body>
<header class="masthead">
  <div class="wrap">
    <div>
      <p class="eyebrow">Formulir laporan kasus elektronik · Disertasi S3 Ilmu Kedokteran FKUI</p>
      <h1>Model ANN untuk diagnosis BOO dan underactive detrusor pada pria dengan LUTS</h1>
    </div>
    <div class="meta">
      <span class="chip acc">Baku emas: pressure-flow study</span>
      <span class="chip">4 RS</span>
    </div>
    <div class="tabs" role="tablist" aria-label="Halaman">
      <button class="tab" role="tab" id="tab-btn-form" aria-selected="true" aria-controls="tab-form">Formulir subjek</button>
      <button class="tab" role="tab" id="tab-btn-map" aria-selected="false" aria-controls="tab-map">Peta parameter</button>
      <button class="tab" role="tab" id="tab-btn-data" aria-selected="false" aria-controls="tab-data">Data tersimpan<span class="count" id="rec-count">0</span></button>
    </div>
  </div>
</header>

<main>
<!-- ================= TAB: FORMULIR ================= -->
<section id="tab-form" role="tabpanel" aria-labelledby="tab-btn-form">
<div class="wrap workspace">
  <nav class="rail" aria-label="Bagian formulir">
    <ol id="rail"></ol>
    <p class="rail-note">Angka di kanan = isian wajib yang sudah terisi. Bagian 7 opsional sesuai protokol (bila citra tersedia).</p>
  </nav>

  <div style="min-width:0">
    <nav class="chipnav" id="chipnav" aria-label="Lompat ke bagian"></nav>

    <div class="banner" id="example-banner">
      <span><b>Data contoh fiktif.</b> Formulir terisi pasien rekaan untuk memperlihatkan alur dan perhitungan otomatis.</span>
      <button class="btn sm" type="button" id="btn-new-top">Mulai formulir kosong</button>
    </div>

    <form id="crf" novalidate autocomplete="off">

    <!-- 1 IDENTITAS -->
    <section class="card" id="sec-1">
      <header class="card-h"><span class="no">01</span><div><h2>Identitas pasien</h2><p>Identitas hanya untuk pencocokan rekam medis. Ekspor anonim mengganti identitas dengan kode subjek.</p></div><span class="chip" data-state="1"></span></header>
      <div class="card-b">
        <div class="fields">
          <div class="field"><label for="f_rs">Rumah sakit <em class="req">wajib</em></label>
            <select id="f_rs">
              <option value="PSH">RSUP Persahabatan</option>
              <option value="CM">RSUPN Dr. Cipto Mangunkusumo</option>
              <option value="UI">RS Universitas Indonesia</option>
              <option value="FTW">RSUP Fatmawati</option>
            </select>
          </div>
          <div class="field"><label for="f_kode">Kode subjek <em class="req">wajib</em></label>
            <div class="unit-in"><input type="text" id="f_kode" spellcheck="false"><button type="button" class="u" id="btn-regen" style="cursor:pointer" title="Buat ulang kode otomatis">↻ auto</button></div>
            <p class="hint">Format RS-urut, mis. PSH-001</p>
          </div>
          <div class="field"><label for="f_tglperiksa">Tanggal Pemeriksaan <em class="req">wajib</em></label><input type="date" id="f_tglperiksa"></div>
          <div class="field full"><label for="f_nama">Nama Pasien <em class="req">wajib</em></label><input type="text" id="f_nama"></div>
          <div class="field"><label for="f_nrm">Nomor Rekam Medis <em class="req">wajib</em></label><input type="text" id="f_nrm" class="mono" spellcheck="false"></div>
          <div class="field"><label for="f_tgllahir">Tanggal lahir <em class="req">wajib</em></label><input type="date" id="f_tgllahir"></div>
          <div class="field"><span class="lbl">Usia</span><div class="readout" id="o_usia">–</div><p class="hint">Dihitung dari tanggal lahir s.d. tanggal pemeriksaan</p></div>
          <div class="field full"><label for="f_alamat">Alamat <em class="opt">opsional</em></label><textarea id="f_alamat" rows="2"></textarea></div>
        </div>
      </div>
    </section>

    <!-- 2 SELEKSI -->
    <section class="card" id="sec-2">
      <header class="card-h"><span class="no">02</span><div><h2>Kriteria inklusi &amp; eksklusi</h2><p>Status kelayakan dihitung otomatis. Data tidak lengkap dinilai dari kelengkapan isian wajib.</p></div><span class="chip" data-state="2"></span></header>
      <div class="card-b">
        <div class="two">
          <div class="panel"><h3>Inklusi — semua harus terpenuhi</h3>
            <div class="checks">
              <div class="check auto"><span class="tick" id="o_inc_age">–</span><span>Laki-laki berusia ≥18 tahun <span class="hint" id="o_inc_age_t">(dari tanggal lahir)</span></span></div>
              <label class="check"><input type="checkbox" id="inc_rm"><span>Tercatat dalam rekam medis RS penelitian</span></label>
              <label class="check"><input type="checkbox" id="inc_lengkap"><span>LUTS dan menjalani anamnesis, uroflowmetri, sistoskopi, USG prostat, dan urodinamik</span></label>
            </div>
          </div>
          <div class="panel"><h3>Eksklusi — centang bila ada</h3>
            <div class="checks">
              <label class="check"><input type="checkbox" id="exc_kateter"><span>Retensi urin dengan kateter menetap atau CIC</span></label>
              <label class="check"><input type="checkbox" id="exc_isk"><span>Infeksi saluran kemih</span></label>
              <label class="check"><input type="checkbox" id="exc_kognitif"><span>Gangguan kognitif/psikiatrik berat sehingga IPSS tidak valid</span></label>
              <label class="check"><input type="checkbox" id="exc_batu"><span>Batu kandung kemih atau tumor buli terkonfirmasi</span></label>
              <label class="check"><input type="checkbox" id="exc_striktur"><span>Striktur uretra berat/obstruksi anatomis sehingga sistoskopi tidak dapat dilakukan</span></label>
            </div>
          </div>
        </div>
        <div id="o_elig" class="chip" style="justify-self:start"></div>
      </div>
    </section>

    <!-- 3 IPSS -->
    <section class="card" id="sec-3">
      <header class="card-h"><span class="no">03</span><div><h2>International Prostate Symptom Score (IPSS)</h2><p>Dalam 1 bulan terakhir. Pilih satu skor per pertanyaan; subskor storage (2, 4, 7) dan voiding (1, 3, 5, 6) dihitung otomatis.</p></div><span class="chip" data-state="3"></span></header>
      <div class="card-b">
        <div class="ipss-strip" aria-live="polite">
          <span>Storage <b id="o_st">–</b><span class="mono" style="color:var(--muted)">/15</span></span>
          <span>Voiding <b id="o_vo">–</b><span class="mono" style="color:var(--muted)">/20</span></span>
          <span>Total <b id="o_tot">–</b><span class="mono" style="color:var(--muted)">/35</span></span>
          <span id="o_sev" class="chip">belum lengkap</span>
          <span style="margin-left:auto">QoL <b id="o_qol">–</b><span class="mono" style="color:var(--muted)">/6</span></span>
        </div>
        <div class="ipss-list" id="ipss-list"></div>
      </div>
    </section>

    <!-- 4 KOMORBID -->
    <section class="card" id="sec-4">
      <header class="card-h"><span class="no">04</span><div><h2>Komorbid &amp; laboratorium</h2><p>Dari rekam medis atau hasil pemeriksaan di fasilitas lain. Kode ekspor mengikuti definisi operasional: 0 = Ya, 1 = Tidak.</p></div><span class="chip" data-state="4"></span></header>
      <div class="card-b">
        <div class="fields">
          <div class="field"><span class="lbl">Diabetes melitus <em class="req">wajib</em></span>
            <div class="seg"><label><input type="radio" name="dm" value="0"><span>Ya <small>0</small></span></label><label><input type="radio" name="dm" value="1"><span>Tidak <small>1</small></span></label></div>
            <p class="hint">Terdiagnosis dan mendapat obat antidiabetik</p>
          </div>
          <div class="field"><span class="lbl">Riwayat stroke <em class="req">wajib</em></span>
            <div class="seg"><label><input type="radio" name="stroke" value="0"><span>Ya <small>0</small></span></label><label><input type="radio" name="stroke" value="1"><span>Tidak <small>1</small></span></label></div>
            <p class="hint">Iskemik atau hemoragik, klinis/radiologis</p>
          </div>
          <div class="field"><span class="lbl">Penyakit saraf perifer <em class="req">wajib</em></span>
            <div class="seg"><label><input type="radio" name="neuro" value="0"><span>Ya <small>0</small></span></label><label><input type="radio" name="neuro" value="1"><span>Tidak <small>1</small></span></label></div>
          </div>
          <div class="field full"><label for="f_neuroket">Keterangan kelainan neurologis <em class="opt">opsional</em></label><input type="text" id="f_neuroket" placeholder="mis. HNP lumbal, riwayat operasi tulang belakang, neuropati diabetik"></div>
        </div>
      </div>
    </section>

    <!-- 5 USG -->
    <section class="card" id="sec-5">
      <header class="card-h"><span class="no">05</span><div><h2>Ultrasonografi prostat</h2><p>Diukur saat kandung kemih terisi &gt;100 mL. IPP diukur pada bidang midsagital, dari ujung protrusi ke dasar dinding buli.</p></div><span class="chip" data-state="5"></span></header>
      <div class="card-b">
        <div class="fields">
          <div class="field"><span class="lbl">Metode</span>
            <div class="seg"><label><input type="radio" name="usg_metode" value="TA" checked><span>Transabdominal</span></label></div>
          </div>
          <div class="field"><label for="f_vp">Volume prostat <em class="req">wajib</em></label><div class="unit-in"><input type="text" inputmode="decimal" id="f_vp"><span class="u">cc</span></div><p class="hint" data-hint="f_vp">Rentang wajar 10–300 cc</p></div>
          <div class="field"><label for="f_ipp">IPP <em class="req">wajib</em></label>
            <div class="unit-in"><input type="text" inputmode="decimal" id="f_ipp"><span class="u" style="padding:0 4px;gap:2px">
              <span class="seg" style="gap:2px;flex-wrap:nowrap"><label><input type="radio" name="ipp_unit" value="cm" checked><span style="padding:3px 8px;font-size:12px">cm</span></label><label><input type="radio" name="ipp_unit" value="mm"><span style="padding:3px 8px;font-size:12px">mm</span></label></span>
            </span></div>
            <p class="hint" data-hint="f_ipp">Intravesical prostatic protrusion · disimpan dalam cm</p>
          </div>
          <div class="field"><span class="lbl">Derajat IPP</span><div class="readout" id="o_ippgrade">–</div><p class="hint">I &lt;0,5 cm · II 0,5–1,0 cm · III &gt;1,0 cm</p></div>
          <label class="check full"><input type="checkbox" id="usg_buli100"><span>Volume buli saat pengukuran &gt;100 mL</span></label>
        </div>
      </div>
    </section>

    <!-- 6 UROFLOW -->
    <section class="card" id="sec-6">
      <header class="card-h"><span class="no">06</span><div><h2>Uroflowmetri</h2><p>Unggah tabel dan kurva hasil uroflow (ekspor PDF dari software alat, atau foto JPG cetakan). Berkas ini menjadi input cabang waveform; angka tabular diisi di bawahnya.</p></div><span class="chip" data-state="6"></span></header>
      <div class="card-b">
        <div id="drop-uf"></div>
        <div class="fields">
          <div class="field"><label for="f_qmax">Qmax <em class="req">wajib</em></label><div class="unit-in"><input type="text" inputmode="decimal" id="f_qmax"><span class="u">mL/s</span></div><p class="hint" data-hint="f_qmax"></p></div>
          <div class="field"><label for="f_qave">Qave</label><div class="unit-in"><input type="text" inputmode="decimal" id="f_qave"><span class="u">mL/s</span></div><p class="hint" data-hint="f_qave"></p></div>
          <div class="field"><label for="f_vv">Voided volume (VV) <em class="req">wajib</em></label><div class="unit-in"><input type="text" inputmode="decimal" id="f_vv"><span class="u">mL</span></div><p class="hint" data-hint="f_vv"></p></div>
          <div class="field"><label for="f_pvr">Post-void residual (PVR) <em class="req">wajib</em></label><div class="unit-in"><input type="text" inputmode="decimal" id="f_pvr"><span class="u">mL</span></div><p class="hint" data-hint="f_pvr">USG buli setelah uroflow</p></div>
          <div class="field"><label for="f_ft">Flow time</label><div class="unit-in"><input type="text" inputmode="decimal" id="f_ft"><span class="u">s</span></div></div>
          <div class="field"><label for="f_tq">Time to Qmax</label><div class="unit-in"><input type="text" inputmode="decimal" id="f_tq"><span class="u">s</span></div></div>
        </div>
        <div class="two">
          <div class="panel"><h3>Kelayakan kurva untuk analisis waveform</h3>
            <label class="check"><input type="checkbox" id="uf_artefak"><span>Kurva banyak artefak (mengejan, gerakan, straining)</span></label>
            <div id="o_wf" class="chip" style="justify-self:start"></div>
            <p class="hint">Layak bila berkas terunggah, VV ≥100 mL, dan artefak minimal.</p>
          </div>
          <div class="panel"><h3>Data mentah waveform <span class="opt">opsional</span></h3>
            <div id="drop-dta"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 SISTOSKOPI -->
    <section class="card" id="sec-7">
      <header class="card-h"><span class="no">07</span><div><h2>Citra sistoskopi</h2><p>Minimal 2 tampilan standar per area, diambil dari rekaman video. Interval dengan urodinamik harus &lt;30 hari.</p></div><span class="chip" data-state="7"></span></header>
      <div class="card-b">
        <div class="fields">
          <div class="field"><label for="f_sistgl">Tanggal sistoskopi</label><input type="date" id="f_sistgl"></div>
          <div class="field"><span class="lbl">Jenis sistoskop</span>
            <div class="seg"><label><input type="radio" name="sis_jenis" value="Rigid"><span>Rigid</span></label><label><input type="radio" name="sis_jenis" value="Fleksibel"><span>Fleksibel</span></label></div>
          </div>
        </div>
        <div class="two">
          <div class="panel"><h3>Leher buli / uretra prostatika</h3><div id="drop-bn"></div></div>
          <div class="panel"><h3>Dinding buli / mukosa</h3><div id="drop-wall"></div></div>
        </div>
        <div class="panel"><h3>Anotasi klinis <span class="opt">untuk interpretabilitas model</span></h3>
          <div class="field"><span class="lbl">Trabekulasi buli</span>
            <div class="seg"><label><input type="radio" name="trab" value="0"><span>Tidak ada</span></label><label><input type="radio" name="trab" value="1"><span>Ringan</span></label><label><input type="radio" name="trab" value="2"><span>Sedang</span></label><label><input type="radio" name="trab" value="3"><span>Berat</span></label></div>
          </div>
          <div class="checks" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
            <label class="check"><input type="checkbox" id="sis_kissing"><span>Oklusi lobus lateral (kissing lobes)</span></label>
            <label class="check"><input type="checkbox" id="sis_medius"><span>Lobus medius / protrusi intravesika</span></label>
            <label class="check"><input type="checkbox" id="sis_bn"><span>Leher buli tinggi</span></label>
            <label class="check"><input type="checkbox" id="sis_divert"><span>Selula / divertikel</span></label>
          </div>
        </div>
      </div>
    </section>

    <div class="form-foot">
      <span class="hint" id="o_foot">–</span>
      <div class="grp">
        <button class="btn" type="button" id="btn-new">Formulir baru</button>
        <button class="btn primary" type="submit" id="btn-save">Simpan subjek</button>
      </div>
    </div>
    </form>
  </div>

  <!-- SUMMARY SHEET -->
  <aside class="sheet" aria-label="Ringkasan subjek">
    <div class="sheet-h">
      <div class="lbl">Lembar ringkasan</div>
      <div class="code" id="s_kode">–</div>
      <div class="sub"><span class="chip" id="s_elig"></span><span class="chip" id="s_age"></span></div>
    </div>
    <div class="sheet-b">
      <div class="srow">
        <span class="k">IPSS total</span><span class="chip" id="s_sev"></span>
        <div class="wide">
          <div class="ipss-big"><b id="s_tot">–</b><span>/35</span><span style="margin-left:auto;font-size:13px">QoL <b id="s_qol" style="font-size:15px;color:var(--fg)">–</b>/6</span></div>
          <div class="bar"><i class="s" id="s_bar_s" style="width:0"></i><i class="v" id="s_bar_v" style="width:0"></i></div>
          <div class="legend"><span><i style="background:var(--warn)"></i>Storage <b id="s_st">–</b></span><span><i style="background:var(--accent)"></i>Voiding <b id="s_vo">–</b></span></div>
        </div>
      </div>
      <div class="srow"><span class="k">Volume prostat</span><span class="v" id="s_vp">–</span></div>
      <div class="srow"><span class="k">IPP</span><span class="v" id="s_ipp">–</span></div>
      <div class="srow"><span class="k">Qmax · VV · PVR</span><span class="v" id="s_uf">–</span></div>
      <div class="srow"><span class="k">Berkas uroflow</span><span class="chip" id="s_uffile"></span></div>
      <div class="srow">
        <span class="k">Kelengkapan isian wajib</span><span class="v" id="s_done">–</span>
        <div class="wide progress"><i id="s_prog"></i></div>
      </div>
    </div>
    <div class="sheet-f">
      <button class="btn primary" type="button" id="btn-save-2">Simpan subjek</button>
    </div>
  </aside>
</div>

<div class="mbar" aria-label="Ringkasan singkat">
  <div class="stats"><span>IPSS <b id="m_ipss">–</b></span><span>VP <b id="m_vp">–</b></span><span>Qmax <b id="m_qmax">–</b></span><span><b id="m_done">–</b></span></div>
  <button class="btn primary sm" type="button" id="btn-save-3">Simpan</button>
</div>
</section>

<!-- ================= TAB: PETA PARAMETER ================= -->
<section id="tab-map" role="tabpanel" aria-labelledby="tab-btn-map" hidden>
<div class="wrap" style="padding-block:24px 64px">
  <div class="section-title" style="margin-top:0"><h2>Dari formulir ke model</h2><p>Lima sumber data, tiga cabang jaringan, satu lapisan fusi, dua label biner.</p></div>
  <div class="map">
    <div class="mod" style="grid-row:1;grid-column:1"><h3>Data klinis <small>Bagian 1–4</small></h3><ul>
