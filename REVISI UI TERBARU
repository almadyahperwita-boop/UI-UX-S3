let records=[];
function autoCode(){
  const v=snapshot(); const pre=`${v.f_rs||"PSH"}-`;
  const used=records.map(r=>r.kode).filter(k=>k.startsWith(pre)).map(k=>parseInt(k.slice(pre.length),10)).filter(Number.isFinite);
  const next=(used.length?Math.max(...used):0)+1; return pre+String(next).padStart(3,"0");
}
