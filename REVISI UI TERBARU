<script>
(function(){
"use strict";
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>Array.from(r.querySelectorAll(s));

/* ---------------- Konstanta penelitian ---------------- */
const SITES={PSH:"RSUP Persahabatan",CM:"RSUPN Dr. Cipto Mangunkusumo",UI:"RS Universitas Indonesia",FTW:"RSUP Fatmawati"};
const FREQ=["Tidak pernah","Kurang dari sekali dalam lima kali","Kurang dari setengah","Kadang-kadang (±50%)","Lebih dari setengah","Hampir selalu"];
const NOCT=["Tidak pernah","1 kali","2 kali","3 kali","4 kali","5 kali atau lebih"];
const QOL=["Senang sekali","Senang","Pada umumnya puas","Campur: puas & tidak","Pada umumnya tidak puas","Tidak senang","Buruk sekali"];
const IPSS=[
 {n:1,t:"Seberapa sering Anda merasa masih ada sisa selesai kencing?",d:"V",s:"Pengosongan tidak lampias"},
 {n:2,t:"Seberapa sering Anda harus kembali kencing dalam waktu kurang dari 2 jam setelah selesai kencing?",d:"S",s:"Frekuensi"},
 {n:3,t:"Seberapa sering Anda mendapatkan bahwa Anda kencing terputus-putus?",d:"V",s:"Intermitensi"},
 {n:4,t:"Seberapa sering Anda merasa sulit untuk menahan kencing Anda?",d:"S",s:"Urgensi"},
 {n:5,t:"Seberapa sering pancaran kencing Anda lemah?",d:"V",s:"Pancaran lemah"},
 {n:6,t:"Seberapa sering Anda harus mengejan untuk mulai kencing?",d:"V",s:"Mengejan"},
 {n:7,t:"Seberapa sering Anda harus bangun untuk kencing, sejak mulai tidur pada malam hari hingga bangun di pagi hari?",d:"S",s:"Nokturia"}
];
const RANGES={f_vp:[5,400,"cc"],f_qmax:[0,60,"mL/s"],f_qave:[0,40,"mL/s"],f_vv:[0,1200,"mL"],f_pvr:[0,2000,"mL"],f_ft:[0,600,"s"],f_tq:[0,300,"s"]};
const SECTIONS=[[1,"Identitas"],[2,"Seleksi"],[3,"IPSS"],[4,"Komorbid"],[5,"USG prostat"],[6,"Uroflowmetri"],[7,"Sistoskopi"]];

/* ---------------- Bangun IPSS ---------------- */
function buildIPSS(){
  const host=$("#ipss-list"); let h="";
  IPSS.forEach(q=>{
    const labels=q.n===7?NOCT:FREQ;
    h+=`<fieldset class="q" id="q${q.n}"><legend><span class="qn">${q.n}</span><span class="qt">${q.t}</span><span class="tags"><span class="tag ${q.d==="S"?"s":"v"}">${q.d==="S"?"Storage":"Voiding"}</span><span class="tag qol">${q.s}</span></span></legend><div class="scale">`;
    labels.forEach((l,i)=>{h+=`<label><input type="radio" name="ipss${q.n}" value="${i}"><span class="opt-box"><b>${i}</b><small>${l}</small></span></label>`;});
    h+=`</div></fieldset>`;
  });
  h+=`<fieldset class="q" id="q8"><legend><span class="qn">QoL</span><span class="qt">Seandainya Anda harus menghabiskan sisa hidup dengan fungsi kencing seperti saat ini, bagaimana perasaan Anda?</span><span class="tags"><span class="tag qol">Kualitas hidup · tidak masuk skor total</span></span></legend><div class="scale s7">`;
  QOL.forEach((l,i)=>{h+=`<label><input type="radio" name="qol" value="${i}"><span class="opt-box"><b>${i}</b><small>${l}</small></span></label>`;});
  h+=`</div></fieldset>`;
  host.innerHTML=h;
}

/* ---------------- Unggahan ---------------- */
let files={uf:null,dta:null,bn:[],wall:[]};
const urlMap=new WeakMap();
function objURL(f){ if(!urlMap.has(f)) urlMap.set(f,URL.createObjectURL(f)); return urlMap.get(f); }
const DROPS={
  uf:{el:"#drop-uf",multi:false,ext:["pdf","jpg","jpeg"],accept:"application/pdf,image/jpeg,.pdf,.jpg,.jpeg",title:"Unggah tabel & kurva uroflow",hint:"PDF hasil ekspor alat atau foto JPG cetakan. Seret berkas ke sini, atau ketuk untuk memilih / memotret.",req:true},
  dta:{el:"#drop-dta",multi:false,ext:["dta","csv","txt"],accept:".dta,.csv,.txt",title:"Berkas .dta dari alat",hint:"Untuk pembacaan sinyal mentah bila tersedia.",compact:true},
  bn:{el:"#drop-bn",multi:true,ext:["jpg","jpeg","png"],accept:"image/jpeg,image/png,.jpg,.jpeg,.png",title:"Tambah citra",hint:"JPG/PNG, minimal 2",compact:true},
  wall:{el:"#drop-wall",multi:true,ext:["jpg","jpeg","png"],accept:"image/jpeg,image/png,.jpg,.jpeg,.png",title:"Tambah citra",hint:"JPG/PNG, minimal 2",compact:true}
};
const ICON_UP=`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"/><path d="m6 10 6-6 6 6"/><path d="M4 20h16"/></svg>`;
function extOf(name){const m=/\.([a-z0-9]+)$/i.exec(name||"");return m?m[1].toLowerCase():"";}
function fmtSize(b){return b<1024*1024?(b/1024).toFixed(0)+" KB":(b/1048576).toFixed(1)+" MB";}

function renderDrop(key){
  const cfg=DROPS[key], host=$(cfg.el), val=files[key];
  if(!host) return;
  let h="";
  if(cfg.multi){
    if(val.length){h+=`<div class="gallery">`+val.map((f,i)=>`<figure><img src="${objURL(f)}" alt="Citra ${i+1}"><figcaption>${esc(f.name)}</figcaption><button type="button" data-rm="${key}" data-i="${i}" aria-label="Hapus citra ${i+1}">×</button></figure>`).join("")+`</div>`;}
    h+=dropHTML(key,cfg, val.length? `${val.length} citra · tambah lagi` : cfg.title);
  } else if(val){
    const isPdf=extOf(val.name)==="pdf";
    if(cfg.compact && !isPdf){
      h+=`<div class="filecard" style="grid-template-columns:minmax(0,1fr)"><div><div class="fname">${esc(val.name)}</div><div class="fmeta">${fmtSize(val.size)}</div><div class="acts"><button type="button" class="btn sm" data-pick="${key}">Ganti</button><button type="button" class="btn sm danger" data-clear="${key}">Hapus</button></div></div></div>`;
    } else {
      h+=`<div class="filecard"><div class="thumb" id="thumb-${key}">${isPdf?"PDF":`<img src="${objURL(val)}" alt="Pratinjau ${esc(val.name)}">`}</div><div style="min-width:0"><div class="fname">${esc(val.name)}</div><div class="fmeta" id="meta-${key}">${isPdf?"PDF":"JPG"} · ${fmtSize(val.size)}</div><div class="acts"><button type="button" class="btn sm" data-pick="${key}">Ganti berkas</button><button type="button" class="btn sm danger" data-clear="${key}">Hapus</button></div><p class="hint" style="margin-top:8px">Akan disimpan sebagai <span class="mono">${exportName(key,val,0)}</span></p></div></div>`;
    }
    h+=`<input type="file" id="file-${key}" accept="${cfg.accept}" hidden>`;
  } else {
    h+=dropHTML(key,cfg,cfg.title);
  }
  host.innerHTML=h;
  if(!cfg.multi && val && extOf(val.name)==="pdf") pdfThumb(key,val);
}
function dropHTML(key,cfg,title){
  return `<label class="drop${cfg.compact?" compact":""}" data-drop="${key}"><input type="file" id="file-${key}" accept="${cfg.accept}" ${cfg.multi?"multiple":""}><span class="ico">${ICON_UP}</span><span><strong>${title}</strong><span class="hint" style="display:block">${cfg.hint}</span></span></label>`;
}
function exportName(key,f,i){
  const code=($("#f_kode").value||"KODE").trim(); const e=extOf(f.name)==="jpeg"?"jpg":extOf(f.name);
  return {uf:`uroflow/${code}_uroflow.${e}`,dta:`waveform_dta/${code}.${e}`,bn:`sistoskopi/${code}_BN_${i+1}.${e}`,wall:`sistoskopi/${code}_DINDING_${i+1}.${e}`}[key];
}
function addFiles(key,list){
  const cfg=DROPS[key]; const ok=[]; let rejected=0;
  Array.from(list||[]).forEach(f=>{ if(cfg.ext.includes(extOf(f.name)) && f.size<=25*1048576) ok.push(f); else rejected++; });
  if(rejected) toast(`Format belum didukung. Gunakan ${cfg.ext.map(x=>x.toUpperCase()).join(" / ")} (maks. 25 MB).`);
  if(!ok.length) return;
  if(cfg.multi) files[key]=files[key].concat(ok); else files[key]=ok[0];
  renderDrop(key); update();
}
document.addEventListener("change",e=>{
  const t=e.target; if(t.type==="file" && t.id.startsWith("file-")){ addFiles(t.id.slice(5),t.files); }
});
document.addEventListener("click",e=>{
  const rm=e.target.closest("[data-rm]"); if(rm){ files[rm.dataset.rm].splice(+rm.dataset.i,1); renderDrop(rm.dataset.rm); update(); return; }
  const cl=e.target.closest("[data-clear]"); if(cl){ files[cl.dataset.clear]=null; renderDrop(cl.dataset.clear); update(); return; }
  const pk=e.target.closest("[data-pick]"); if(pk){ const inp=$("#file-"+pk.dataset.pick); if(inp) inp.click(); }
});
["dragenter","dragover"].forEach(ev=>document.addEventListener(ev,e=>{const d=e.target.closest&&e.target.closest("[data-drop]"); if(d){e.preventDefault(); d.classList.add("over");}}));
["dragleave","drop"].forEach(ev=>document.addEventListener(ev,e=>{const d=e.target.closest&&e.target.closest("[data-drop]"); if(d){d.classList.remove("over"); if(ev==="drop"){e.preventDefault(); addFiles(d.dataset.drop,e.dataTransfer.files);}}}));

/* Pratinjau PDF halaman 1 (pdf.js dimuat saat dibutuhkan) */
const PDFJS="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/";
let pdfLoading=null;
function loadScript(src){return new Promise((res,rej)=>{const s=document.createElement("script");s.src=src;s.onload=res;s.onerror=rej;document.head.appendChild(s);});}
function getPdf(){ if(!pdfLoading){ pdfLoading=loadScript(PDFJS+"pdf.min.js").then(()=>loadScript(PDFJS+"pdf.worker.min.js")).then(()=>{const lib=window.pdfjsLib||window["pdfjs-dist/build/pdf"]; lib.GlobalWorkerOptions.workerSrc=PDFJS+"pdf.worker.min.js"; return lib;}); } return pdfLoading; }
async function pdfThumb(key,f){
  try{
    const lib=await Promise.race([getPdf(),new Promise((_,r)=>setTimeout(()=>r("t"),8000))]);
    const doc=await lib.getDocument({data:new Uint8Array(await f.arrayBuffer())}).promise;
    const page=await doc.getPage(1); const vp0=page.getViewport({scale:1}); const vp=page.getViewport({scale:360/vp0.width});
    const c=document.createElement("canvas"); c.width=vp.width; c.height=vp.height;
    await page.render({canvasContext:c.getContext("2d"),viewport:vp}).promise;
    if(files[key]!==f) return;
    const th=$("#thumb-"+key); if(th){th.innerHTML=""; th.appendChild(c);}
    const m=$("#meta-"+key); if(m) m.textContent=`PDF · ${doc.numPages} halaman · ${fmtSize(f.size)}`;
  }catch(err){ const m=$("#meta-"+key); if(m && files[key]===f) m.textContent=`PDF · ${fmtSize(f.size)} · pratinjau tidak tersedia`; }
}

/* ---------------- Snapshot & turunan ---------------- */
function snapshot(){
  const v={};
  $$("#crf input, #crf select, #crf textarea").forEach(el=>{
    if(el.type==="file") return;
    if(el.type==="radio"){ if(!(el.name in v)) v[el.name]=""; if(el.checked) v[el.name]=el.value; return; }
    if(el.type==="checkbox"){ v[el.id]=el.checked; return; }
    if(el.id) v[el.id]=el.value;
  });
  return v;
}
function restore(v){
  $$("#crf input, #crf select, #crf textarea").forEach(el=>{
    if(el.type==="file") return;
    if(el.type==="radio"){ el.checked = v[el.name]===el.value; return; }
    if(el.type==="checkbox"){ el.checked=!!v[el.id]; return; }
    if(el.id) el.value = (el.id in v)? v[el.id] : (el.tagName==="SELECT"? el.options[0].value : "");
  });
}
function num(x){ if(x==null) return null; const s=String(x).trim().replace(",","."); if(s==="") return null; const k=Number(s); return Number.isFinite(k)?k:null; }
function ageYears(dob,ref){
  if(!dob) return null; const b=new Date(dob+"T00:00:00"), r=ref? new Date(ref+"T00:00:00") : new Date();
  if(isNaN(b)||isNaN(r)) return null; let a=r.getFullYear()-b.getFullYear(); const m=r.getMonth()-b.getMonth(); if(m<0||(m===0&&r.getDate()<b.getDate())) a--; return a>=0&&a<130?a:null;
}
function daysBetween(a,b){ if(!a||!b) return null; const x=new Date(a+"T00:00:00"), y=new Date(b+"T00:00:00"); if(isNaN(x)||isNaN(y)) return null; return Math.round((y-x)/86400000); }

function derive(v,f){
  const d={};
  d.age=ageYears(v.f_tgllahir,v.f_tglperiksa);
  d.q=IPSS.map(q=> v["ipss"+q.n]===""||v["ipss"+q.n]==null? null : Number(v["ipss"+q.n]));
  const sum=idx=> idx.every(i=>d.q[i-1]!==null)? idx.reduce((a,i)=>a+d.q[i-1],0) : null;
  d.storage=sum([2,4,7]); d.voiding=sum([1,3,5,6]);
  d.total=(d.storage!==null&&d.voiding!==null)? d.storage+d.voiding : null;
  d.partS=[2,4,7].reduce((a,i)=>a+(d.q[i-1]||0),0); d.partV=[1,3,5,6].reduce((a,i)=>a+(d.q[i-1]||0),0);
  d.severity=d.total===null?null: d.total<=7?"Ringan": d.total<=19?"Sedang":"Berat";
  d.qol=v.qol===""||v.qol==null?null:Number(v.qol);
  d.vp=num(v.f_vp);
  const ipp=num(v.f_ipp); d.ippCm=ipp===null?null:(v.ipp_unit==="mm"? ipp/10 : ipp);
  d.ippGrade=d.ippCm===null?null: d.ippCm<0.5?"I": d.ippCm<=1.0?"II":"III";
  d.qmax=num(v.f_qmax); d.qave=num(v.f_qave); d.vv=num(v.f_vv); d.pvr=num(v.f_pvr); d.ft=num(v.f_ft); d.tq=num(v.f_tq);
  d.wfOk = !f.uf? null : (d.vv!==null && d.vv>=100 && !v.uf_artefak);
  // kelayakan
  d.incAge = d.age===null? null : d.age>=18;
  d.exc=["exc_kateter","exc_isk","exc_kognitif","exc_batu","exc_striktur"].filter(k=>v[k]);
  const incAll = d.incAge===true && v.inc_rm && v.inc_lengkap;
  d.eligible = (d.exc.length || d.incAge===false)? false : incAll? true : null;
  // kelengkapan
  const R={
    1:[v.f_rs,(v.f_kode||"").trim(),(v.f_nama||"").trim(),(v.f_nrm||"").trim(),v.f_tgllahir,v.f_tglperiksa],
    2:[v.inc_rm,v.inc_lengkap,d.incAge!==null],
    3:[...d.q.map(x=>x!==null),d.qol!==null],
    4:[v.dm,v.stroke,v.neuro],
    5:[d.vp!==null,d.ippCm!==null],
    6:[!!f.uf,d.qmax!==null,d.vv!==null,d.pvr!==null],
    7:[!!v.f_sistgl,f.bn.length>=2,f.wall.length>=2]
  };
  d.sec={}; let done=0,tot=0;
  Object.keys(R).forEach(k=>{const a=R[k]; const c=a.filter(Boolean).length; d.sec[k]={done:c,total:a.length}; if(k!=="7"){done+=c;tot+=a.length;}});
  d.reqDone=done; d.reqTotal=tot;
  d.status = d.eligible===false? "Tidak layak" : (done===tot && d.eligible===true)? "Lengkap" : "Belum lengkap";
  return d;
}

/* ---------------- Render ---------------- */
function setChip(el,text,cls){ if(!el) return; el.className="chip"+(cls?" "+cls:""); el.innerHTML=text? `<span class="dot"></span>${text}`:""; el.hidden=!text; }
function fx(x,dp=1){ if(x===null||x===undefined) return "–"; const s=Number.isInteger(x)? String(x) : x.toFixed(dp); return s.replace(".",","); }
function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));}

function buildNav(){
  $("#rail").innerHTML=SECTIONS.map(([n,t])=>`<li><a href="#sec-${n}" data-nav="${n}"><span class="no">${n}</span><span>${t}</span><span class="frac" data-frac="${n}"></span></a></li>`).join("");
  $("#chipnav").innerHTML=SECTIONS.map(([n,t])=>`<a href="#sec-${n}" class="chip" data-cnav="${n}">${n} · ${t}</a>`).join("");
}
document.addEventListener("click",e=>{ const a=e.target.closest("a[href^='#sec-']"); if(a){ e.preventDefault(); const t=document.getElementById(a.getAttribute("href").slice(1)); if(t) t.scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth",block:"start"}); }});

function rangeHints(v){
  Object.keys(RANGES).forEach(id=>{
    const el=document.getElementById(id); if(!el) return; const [lo,hi,u]=RANGES[id]; const raw=(v[id]||"").trim(); const x=num(raw);
    const hint=document.querySelector(`[data-hint="${id}"]`);
    let bad=false,msg=null; if(hint && !("base" in hint.dataset)) hint.dataset.base=hint.textContent;
    if(raw!=="" && x===null){bad=true;msg="Isi dengan angka, mis. 12,5";}
    else if(x!==null && (x<lo||x>hi)){bad=true;msg=`Di luar rentang wajar ${lo}–${hi} ${u}. Periksa kembali.`;}
    el.classList.toggle("bad",bad);
    if(hint){ hint.textContent=msg||hint.dataset.base; hint.className="hint"+(bad?" bad":""); }
  });
  // IPP: kemungkinan salah satuan
  const ipp=num(v.f_ipp), h=document.querySelector('[data-hint="f_ipp"]');
  if(!("base" in h.dataset)) h.dataset.base=h.textContent;
  if(ipp!==null && v.ipp_unit==="cm" && ipp>4){ h.textContent=`${fx(ipp)} cm terlalu besar — mungkin dalam mm? Ganti satuan ke mm.`; h.className="hint warn"; }
  else if(ipp!==null && v.ipp_unit==="mm"){ h.textContent=`= ${fx(ipp/10,2)} cm (disimpan dalam cm)`; h.className="hint"; }
  else { h.textContent=h.dataset.base; h.className="hint"; }
  // VV untuk waveform
  const vh=document.querySelector('[data-hint="f_vv"]'); const vv=num(v.f_vv);
  if(vv!==null && vv<100 && !$("#f_vv").classList.contains("bad")){ vh.textContent="VV <100 mL: kurva tidak masuk analisis waveform"; vh.className="hint warn"; }
  else if(!$("#f_vv").classList.contains("bad")){ vh.textContent=vh.dataset.base||""; vh.className="hint"; }
}

let isExample=false;
function update(){
  const v=snapshot(), d=derive(v,files);
  // identitas
  $("#o_usia").textContent = d.age===null? "–" : `${d.age} tahun`;
  // seleksi
  const ta=$("#o_inc_age"); ta.className="tick"+(d.incAge===true?" ok":d.incAge===false?" bad":""); ta.textContent=d.incAge===true?"✓":d.incAge===false?"✕":"–";
  $("#o_inc_age_t").textContent = d.age===null? "(isi tanggal lahir di Bagian 1)" : `(${d.age} tahun)`;
  const eligTxt = d.eligible===true?"Memenuhi kriteria" : d.eligible===false? (d.exc.length? `Tidak layak · ${d.exc.length} kriteria eksklusi` : "Tidak layak · usia <18 tahun") : "Kelayakan belum dinilai";
  const eligCls = d.eligible===true?"ok":d.eligible===false?"bad":"";
  setChip($("#o_elig"),eligTxt,eligCls); setChip($("#s_elig"),d.eligible===true?"Layak":d.eligible===false?"Tidak layak":"Belum dinilai",eligCls);
  setChip($("#s_age"), d.age===null? "Usia –" : `${d.age} th`, "");
  // IPSS
  $("#o_st").textContent=d.storage??(d.partS?d.partS+"…":"–"); $("#o_vo").textContent=d.voiding??(d.partV?d.partV+"…":"–");
  $("#o_tot").textContent=d.total??"–"; $("#o_qol").textContent=d.qol??"–";
  const sevCls={Ringan:"ok",Sedang:"warn",Berat:"bad"}[d.severity]||"";
  const answered=d.q.filter(x=>x!==null).length;
  setChip($("#o_sev"), d.severity? `Gejala ${d.severity.toLowerCase()}` : `${answered}/7 terjawab`, sevCls);
  setChip($("#s_sev"), d.severity? d.severity : `${answered}/7`, sevCls);
  $("#s_tot").textContent=d.total??(answered? d.partS+d.partV : "–");
  $("#s_qol").textContent=d.qol??"–"; $("#s_st").textContent=d.storage??"–"; $("#s_vo").textContent=d.voiding??"–";
  $("#s_bar_s").style.width=(d.partS/35*100)+"%"; $("#s_bar_v").style.width=(d.partV/35*100)+"%";
  // USG
  $("#o_ippgrade").innerHTML = d.ippGrade? `Derajat ${d.ippGrade} <span style="color:var(--muted);margin-left:6px;font-weight:400">(${fx(d.ippCm,2)} cm)</span>` : "–";
  $("#s_vp").innerHTML = d.vp===null?"–":`${fx(d.vp)} <small>cc</small>`;
  $("#s_ipp").innerHTML = d.ippCm===null?"–":`${fx(d.ippCm,2)} <small>cm · ${d.ippGrade}</small>`;
  // Uroflow
  $("#s_uf").innerHTML = [d.qmax,d.vv,d.pvr].every(x=>x===null)? "–" : `${fx(d.qmax)} · ${fx(d.vv,0)} · ${fx(d.pvr,0)}`;
  setChip($("#s_uffile"), files.uf? (extOf(files.uf.name)==="pdf"?"PDF terunggah":"JPG terunggah") : "Belum ada", files.uf?"ok":"warn");
  setChip($("#o_wf"), d.wfOk===null? "Menunggu berkas uroflow" : d.wfOk? "Layak untuk analisis waveform" : "Tidak layak untuk waveform", d.wfOk===null?"":d.wfOk?"ok":"warn");
  // kode & kelengkapan
  $("#s_kode").textContent=(v.f_kode||"").trim()||"Tanpa kode";
  const pct=Math.round(d.reqDone/d.reqTotal*100);
  $("#s_done").textContent=`${d.reqDone}/${d.reqTotal}`; $("#s_prog").style.width=pct+"%";
  $("#o_foot").textContent=`Isian wajib ${d.reqDone}/${d.reqTotal} · status: ${d.status}`;
  SECTIONS.forEach(([n])=>{
    const s=d.sec[n]; const full=s.done===s.total, part=s.done>0;
    const a=document.querySelector(`[data-nav="${n}"]`); if(a){ a.dataset.done=full?"full":part?"part":"none"; }
    const fr=document.querySelector(`[data-frac="${n}"]`); if(fr) fr.textContent = (n===7 && !full)? "opsional" : `${s.done}/${s.total}`;
    const c=document.querySelector(`[data-cnav="${n}"]`); if(c) c.className="chip"+(full?" ok":"");
    setChip(document.querySelector(`[data-state="${n}"]`), full? "Lengkap" : (n===7? `${s.done}/${s.total} · opsional` : `${s.done}/${s.total}`), full?"ok":"");
  });
  // bar mobile
  $("#m_ipss").textContent=d.total??"–"; $("#m_vp").textContent=d.vp===null?"–":fx(d.vp); $("#m_qmax").textContent=d.qmax===null?"–":fx(d.qmax); $("#m_done").textContent=pct+"%";
  rangeHints(v);
  return {v,d};
}

